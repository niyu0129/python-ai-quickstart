# ============================================================
# 环境变量模板
#
# 使用方法：
#   1. 把这个文件复制成 .env（去掉 .example 后缀）
#   2. 填入你自己的密钥
#   3. 确认 .gitignore 里包含 .env —— 绝对不能提交到 git！
#
# PowerShell 复制命令：
#   Copy-Item .env.example .env
# ============================================================

# ---------- 大模型对话接口 ----------
# 国内厂商示例（三选一，按你注册的那家改）
OPENAI_API_KEY=sk-在这里填你的密钥
# DeepSeek：      https://api.deepseek.com/v1
# 阿里通义：      https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM：      https://open.bigmodel.cn/api/paas/v4
# 月之暗面：      https://api.moonshot.cn/v1
# 本地 Ollama：   http://localhost:11434/v1  （key 随便填，比如 ollama）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名（按厂商文档填，注意区分大小写）
OPENAI_MODEL=deepseek-chat

# 视觉模型（第 11 天项目四用）
VISION_MODEL=gpt-4o-mini

# ---------- Embedding（向量化） ----------
# local = 本地 sentence-transformers（免费、离线，首次运行会自动下载模型）
# api   = 走 OpenAI 兼容的 embeddings 接口（需要该厂商支持）
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 用 api 时把上面两行改成：
# EMBED_BACKEND=api
# EMBED_MODEL=text-embedding-3-small

# ---------- 联网搜索（可选，Agent 用） ----------
# 注册地址：https://tavily.com  （有免费额度）
TAVILY_API_KEY=

# ---------- 国内下载模型加速（可选） ----------
# HF_ENDPOINT=https://hf-mirror.com
